# Copy this file to .env (local dev) and also set these in Netlify's
# Site settings → Environment variables (for production builds).
#
# Both values below are PUBLIC and safe to ship in the browser bundle —
# they are the Supabase project URL and the anonymous/public API key, which
# is designed to be used client-side and is meaningless without Row Level
# Security policies (which this project has) enforcing what it can access.
#
# NEVER put your Supabase service_role key here or anywhere under /src —
# it belongs only in the Supabase Edge Functions environment (set via
# `supabase secrets set` or the Supabase dashboard), never in a Netlify
# frontend env var, never in git.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
